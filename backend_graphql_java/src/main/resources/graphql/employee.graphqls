type Employee {
    id: Int
    name: String
    email: String
    job: String
    pay: Int
}

input EmployeeInput {
    name: String
    email: String
    job: String
    pay: Int
}

type Query {
    employees: [Employee]
    employee(id: Int!): Employee
}

type Mutation {
    createEmployee(input: EmployeeInput!): Employee
    updateEmployee(id: Int!, input: EmployeeInput!): Employee
    deleteEmployee(id: Int!): Boolean
}